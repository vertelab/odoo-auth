<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apps_access_right_ir_module_module_view_kanban" model="ir.ui.view">
        <field name="name">ir.module.module.view.kanban.inherit.mail</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base_install_request.ir_module_module_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="inside">
                <field name="is_apps_manager"/>
            </xpath>
            <button name="action_open_install_request" position="replace">
                <button type="object" class="btn btn-primary btn-sm" name="action_open_install_request" invisible="is_apps_manager or state != 'uninstalled'" t-if="!record.to_buy.raw_value">Request Access</button>
            </button>
        </field>
    </record>

    <record id="apps_access_right_module_view_kanban" model="ir.ui.view">
        <field name="name">ir.module.module.view.kanban.inherit.mail</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="inside">
                <field name="is_apps_manager"/>
            </xpath>
            <button name="button_immediate_install" position="replace">
                <button type="object" class="btn btn-primary btn-sm" name="button_immediate_install" invisible="not is_apps_manager or state != 'uninstalled'" t-if="! record.to_buy.raw_value" groups="base.group_system">Activate</button>
            </button>
        </field>
    </record>

    <record id="apps_access_right_module_form" model="ir.ui.view">
        <field name="name">ir.module.module.view.kanban.inherit.mail</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_apps_manager" invisible="1"/>
            </field>
            <button name="button_immediate_install" position="replace">
                <button name="button_immediate_install" string="Activate" invisible="not is_apps_manager or to_buy or state != 'uninstalled'" type="object" class="btn btn-primary me-1" groups="base.group_system"/>
                <button name="action_open_install_request" string="Request Access" invisible="is_apps_manager or to_buy or state != 'uninstalled'" type="object" class="btn btn-primary me-1"/>
            </button>
        </field>
    </record>

</odoo>
