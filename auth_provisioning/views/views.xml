<odoo>
  <data>
   <record id="view_res_users_form" model="ir.ui.view">
        <field name="name">view_res_users_form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile_phone']" position="after">
                <field name="base_url_parameter"/>
                <field name="qrcode" widget="image"/>
            </xpath>
        </field>
     </record>
  </data>
</odoo>

